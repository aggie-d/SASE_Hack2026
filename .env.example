# Copy this file to .env.local and fill in your values.
# Get these from: Supabase dashboard → Project → Settings → API
NEXT_PUBLIC_APP_NAME=LAD Transfer
NEXT_PUBLIC_DEMO_MODE=true

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. Bypasses RLS; used by lib/server/** for ledger writes and by
# integration tests. Never prefix with NEXT_PUBLIC_ and never commit the real value.
# Supabase dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Lithic sandbox — server-only card provider credential.
# Never prefix with NEXT_PUBLIC_ and never commit the real value.
LITHIC_API_KEY=

# Mock collection provider (Workstream C). POST /api/v1/webhooks/mock verifies
# an HMAC-SHA256 of the raw body in the x-mock-signature header using this
# secret. Must be at least 32 characters or the route returns INTERNAL_ERROR.
# Generate one with:  openssl rand -hex 32
MOCK_WEBHOOK_SECRET=

# Mock FX provider outcome for POST /api/v1/conversions.
# completed (default) | pending (stays pending until POST /demo/events) | failed
MOCK_FX_OUTCOME=completed

# FX rates. By default every price in the app (deposit page, POST /quotes,
# POST /deposits) comes live from fawazahmed0/exchange-api — no key needed.
# For a presentation, pin MWK so the number can't move mid-demo and survives a
# dead conference Wi-Fi. Leave EMPTY for live rates. Example: 1736.15
# (Google "USD to MWK" the morning of the demo and paste it here.)
FX_RATE_OVERRIDE_MWK_PER_USDT=

# Local demo seed account. Put actual values only in .env.local.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=